<?xml version="1.0" encoding="UTF-8"?>
<!--
  Unidade usada apenas nos testes. A conexao (H2 em memoria) fica em
  src/test/resources/application.properties.
  As tabelas sao criadas pelas mesmas migrations do Flyway usadas na aplicacao
  (MigracaoBanco.migrar() no @BeforeAll), e o Hibernate apenas valida o schema.
-->
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="pgcdTestPU" transaction-type="RESOURCE_LOCAL">
        <class>br.com.ifba.produto.entity.Produto</class>
        <class>br.com.ifba.produto.entity.Categoria</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
    </persistence-unit>
</persistence>
